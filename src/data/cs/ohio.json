38,49192,54109,58818],[332400,25562,37736,44084,49244,54167,58880],[333000,25585,37772,44131,49296,54224,58942],[333600,25607,37809,44178,49348,54281,59005],[334200,25630,37845,44224,49400,54339,59067],[334800,25652,37882,44271,49452,54396,59129],[335400,25675,37918,44318,49504,54453,59191],[336000,25697,37955,44364,49556,54511,59254]],"lookup":"interpolate","minIncome":8400,"maxIncome":336000,"aboveMax":{"method":"discretion","pct":null},"columnFor":null},"percent":null,"formula":null,"shared":{"method":"percent-reduction","thresholdOvernights":90,"multiplier":null,"reductionTable":[[90,10]]},"addOns":{"childcare":true,"health":true},"extra":{"shadedAreaMaxIncomeByChildren":[39000,74400,91200,108000,121800,133200],"parentingTimeReduction":{"minOvernights":90,"pct":10,"source":"ORC 3119.051(A)"},"childCareSharePctCapInReserve":50,"childCareSharePctCapSource":"ORC 3119.05(P)(2)","minimumOrderMonthly":80,"minimumOrderSource":"ORC 3119.06(A), https://codes.ohio.gov/ohio-revised-code/section-3119.06","cashMedicalAnnualPerChild":510.21,"cashMedicalSource":"https://dam.assets.ohio.gov/image/upload/v1774376628/jfs.ohio.gov/EBS/Programs%20Rules%20and%20Resources/Child%20Support/CSPMTLs/2026/CSPMTL-206_Ohio_Child_Support_Guideline_Rules_and_Form.pdf (JFS 07766 rev. 4/2026, Table 3)","columns":["combinedAnnualIncome","1","2","3","4","5","6"]},"lowIncome":{"selfSupportReserve":null,"period":"monthly","minimumOrder":80,"method":"text"},"statute":{"name":"ORC §§ 3119.01-3119.06, 3119.021, 3119.051, 3119.30; OAC 5101:12-1-17","url":"https://codes.ohio.gov/ohio-revised-code/section-3119.021"},"guidelinesUrl":"https://dam.assets.ohio.gov/image/upload/v1774376628/jfs.ohio.gov/EBS/Programs%20Rules%20and%20Resources/Child%20Support/CSPMTLs/2026/CSPMTL-206_Ohio_Child_Support_Guideline_Rules_and_Form.pdf","officialCalculatorUrl":null,"incomeDefinition":"Annual gross income of each parent: all earned and unearned income (wages, overtime and bonuses per § 3119.05(D), commissions, self-generated income, rents, dividends, pensions, non-means-tested social security, workers' compensation, unemployment, spousal support received, military pay and allowances, etc.), excluding means-tested benefits, child support received for other children, nonrecurring income and Title IV-E payments (ORC § 3119.01(C)(13)). Adjustments: court-ordered spousal support paid is deducted (§ 3119.05(B)); a credit for other children not in the order (§ 3119.05(C)); the out-of-pocket health insurance premium is credited against the paying parent's income (§ 3119.30(E)).","modelText":"ORC § 3119.05(G)(2) and JFS 07766: if income falls between two schedule rows, the court or agency may use the higher row, the lower row, or a proportional amount between the two (all three are permitted; interpolation is one allowed option).","sharedText":"ORC § 3119.051(A): the annual individual support obligation of a parent with a court-ordered parenting time order of 90 or more overnights per year is reduced by 10%, in addition to other deviations; the court may remove the reduction at the obligee's request if the obligor fails without just cause to exercise parenting time (§ 3119.051(B)). A larger adjustment requires a court deviation (JFS 07766 line 19).","addOnsText":"shared by income share, capped by statewide maximum per child premium credited against the payer's income; separate cash medical support ORC § 3119.05(P): child care for work or training is shared by income share, net of subsidies and tax credits, and capped at the statewide average cost (JFS 07766 Table 2: $16,116 infant, $14,254 toddler, $12,801 pre-school, $8,780 school-age per year). Cash medical support of $510.21 per child per year (JFS 07766 Table 3, MEPS 2021) is split by income share (§ 3119.30(C)); medical expenses above it are extraordinary. The out-of-pocket health insurance premium is a credit against the paying parent's income (§ 3119.30(E)); the obligee is presumed to provide coverage (§ 3119.30(B)).","lowIncomeText":"Self-sufficiency reserve built into the shaded area of JFS 07767 (116% of federal poverty level for one person, § 3119.021(B)(2)); sliding scale minimum order below it (§ 3119.021(B)(2)(a)-(d): 5% to 15% multipliers of income above $8,400 plus the minimum order); minimum order $80 per month for all children (§ 3119.06(A)).","emancipation":{"text":"Support under a court order continues past 18 only for a disabled child who cannot self-support, by the parents' incorporated agreement, or while the child continuously attends an accredited high school full time; under an administrative order only the high school case applies (ORC § 3119.86, as amended eff. March 20, 2025).","url":"https://web.archive.org/web/20260512122451/https://codes.ohio.gov/ohio-revised-code/section-3119.86"},"scheduleText":"ORC § 3119.05(G)(2) and JFS 07766: if income falls between two schedule rows, the court or agency may use the higher row, the lower row, or a proportional amount between the two (all three are permitted; interpolation is one allowed option).","aboveMaxText":"ORC § 3119.04: above the schedule maximum, support is set case by case considering needs and standard of living, and the basic combined obligation may not be less than the amount at the schedule maximum ($336,000 in JFS 07767 rev. 6/2023) unless the court finds that unjust or inappropriate and journalizes its findings.","effective":"2023-06-01","facts":[{"text":"The schedule must be updated every four years for CPI-U changes and the federal poverty level (ORC § 3119.021(C)); the current JFS 07767 is revision 6/2023.","url":"https://web.archive.org/web/20250914192347/https://codes.ohio.gov/ohio-revised-code/section-3119.021"},{"text":"Ohio uses gross, not net, income and lists income in $600 annual steps from $8,400 to $336,000.","url":"https://dam.assets.ohio.gov/image/upload/v1774376628/jfs.ohio.gov/EBS/Programs%20Rules%20and%20Resources/Child%20Support/CSPMTLs/2026/CSPMTL-206_Ohio_Child_Support_Guideline_Rules_and_Form.pdf"},{"text":"Overtime and bonuses count at the lesser of the three-year average or the prior year's total (ORC § 3119.05(D)).","url":"https://web.archive.org/web/20260510202022/https://codes.ohio.gov/ohio-revised-code/section-3119.05"},{"text":"For more than six children, the three-child amount is multiplied by 1.440 (7 children) up to 2.182 (more than 14) (ORC § 3119.05(C)(4)).","url":"https://web.archive.org/web/20260510202022/https://codes.ohio.gov/ohio-revised-code/section-3119.05"},{"text":"Every order includes cash medical support of $510.21 per child per year, split by income share (JFS 07766 rev. 4/2026, Table 3; ORC § 3119.30(C)).","url":"https://dam.assets.ohio.gov/image/upload/v1774376628/jfs.ohio.gov/EBS/Programs%20Rules%20and%20Resources/Child%20Support/CSPMTLs/2026/CSPMTL-206_Ohio_Child_Support_Guideline_Rules_and_Form.pdf"}],"sources":[{"name":"Ohio: ORC §§ 3119.01-3119.06, 3119.021, 3119.051, 3119.30; OAC 5101:12-1-17","url":"https://codes.ohio.gov/ohio-revised-code/section-3119.021"},{"name":"Ohio: child support guidelines","url":"https://dam.assets.ohio.gov/image/upload/v1774376628/jfs.ohio.gov/EBS/Programs%20Rules%20and%20Resources/Child%20Support/CSPMTLs/2026/CSPMTL-206_Ohio_Child_Support_Guideline_Rules_and_Form.pdf"},{"name":"Ohio: official schedule of basic support obligations","url":"https://dam.assets.ohio.gov/image/upload/jfs.ohio.gov/EBS/Programs%20Rules%20and%20Resources/Child%20Support/CSPMTLs/2023/CSPMTL_186_-_Five_Year_Rule_Review_Child_Support_Guidelines.pdf"},{"name":"Ohio: shared parenting rule","url":"https://web.archive.org/web/20260515201853/https://codes.ohio.gov/ohio-revised-code/section-3119.051"},{"name":"Ohio: low-income rule","url":"https://web.archive.org/web/20260412234108/https://codes.ohio.gov/ohio-revised-code/section-3119.06"},{"name":"Ohio: when support ends","url":"https://web.archive.org/web/20260512122451/https://codes.ohio.gov/ohio-revised-code/section-3119.86"},{"name":"Ohio: web.archive.org","url":"https://web.archive.org/web/20250914192347/https://codes.ohio.gov/ohio-revised-code/section-3119.021"},{"name":"Ohio: web.archive.org","url":"https://web.archive.org/web/20260510202022/https://codes.ohio.gov/ohio-revised-code/section-3119.05"}],"testCases":[{"inputs":{"incomeA":90000,"incomeB":30000,"children":2,"overnightsA":0,"period":"annual gross"},"expected":16302.0,"what":"paying parent's annual child support obligation before child care, cash medical and deviations ($1,358.50 per month)","source":"Computed by hand from JFS 07767 (rev. 6/2023): combined $120,000, two children = $21,736; A's income share 75%; 21736 x 0.75 = 16302. A's own income ($90,000) is outside the two-child shaded area (ends $74,400), so no SSR comparison. No official worked example used."},{"inputs":{"incomeA":90000,"incomeB":30000,"children":2,"overnightsA":90,"period":"annual gross"},"expected":14671.8,"what":"parent A's annual obligation after the 10% reduction for a 90+ overnight parenting time order (§ 3119.051); $1,222.65 per month","source":"Computed by hand: 16302 x 0.90 = 14671.80."},{"inputs":{"incomeA":30000,"incomeB":90000,"children":2,"overnightsA":0},"expected":3926,"what":"paying parent's annual obligation when that parent's own income is in the shaded self-sufficiency reserve area (lesser amount, ORC 3119.05(G)(3))","source":"Computed by hand from JFS 07767: combined $120,000 two children $21,736 x 25% = $5,434; paying parent's own income $30,000 two children = $3,926 (shaded); lesser = $3,926."},{"inputs":{"incomeA":300000,"incomeB":100000,"children":2,"overnightsA":0},"expected":28466.25,"what":"paying parent's annual obligation above the $336,000 top row, floored at the top-row amount (ORC 3119.04)","source":"Computed by hand: top row two children $37,955 x 75% = $28,466.25 (the court may order more case by case)."}]}