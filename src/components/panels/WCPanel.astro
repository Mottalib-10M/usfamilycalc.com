---
/**
 * The official rules of a state's workers' comp benefit, generated from its data file. Identical in
 * form on every state page: marked data-chrome (RECETTE §6.4); the prose above is what differs.
 */
import { wc, usdx, pct, day } from '../../lib/kit';
import { table } from '../../lib/helpers';
interface Props { slug: string }
const d = wc(Astro.props.slug);
const T = d.ttd;
const stale = T.effective.slice(0, 4) < '2026';
const rows: Array<Array<string>> = [
  ['Temporary total disability rate', `${pct(T.rate)} of ${T.basisLabel.toLowerCase()}`],
  ['Weekly maximum', T.max != null ? usdx(T.max) : 'none'],
  ['Weekly minimum', T.min != null ? usdx(T.min) : 'none'],
  ['Applies to', T.periodLabel],
  ['Waiting period', d.waiting.days != null ? `${d.waiting.days} days${d.waiting.retroactiveAfterDays != null ? `, paid back when the disability lasts more than ${d.waiting.retroactiveAfterDays} days` : ''}` : 'see the rule below'],
  ['Limit on temporary total benefits', d.ttdDuration.maxWeeks != null ? `${d.ttdDuration.maxWeeks} weeks` : 'no fixed number of weeks'],
];
---
<section data-chrome class="mt-10">
  <h2 class="font-serif text-2xl font-bold text-navy-900">The {d.name} rules this calculator applies</h2>
  <Fragment set:html={table(['Rule', d.name], rows, `${d.agency.name}, read on ${day(d.verified)}`, ['l', 'l'])} />
  {stale && <p class="text-sm text-navy-700">The {d.agency.name} had not published a 2026 figure when we checked on {day(d.verified)}: the calculator uses the latest official maximum and minimum, effective {day(T.effective)}.</p>}
  <div class="prose prose-slate mt-4 max-w-none text-sm">
    <p><strong>Rate.</strong> {T.rateText} <a href={T.url} target="_blank" rel="nofollow noopener noreferrer">source</a></p>
    <p><strong>Waiting period.</strong> {d.waiting.text} <a href={d.waiting.url} target="_blank" rel="nofollow noopener noreferrer">source</a></p>
    <p><strong>Duration.</strong> {d.ttdDuration.text} <a href={d.ttdDuration.url} target="_blank" rel="nofollow noopener noreferrer">source</a></p>
    <p><strong>Permanent disability.</strong> {d.ppd.text} <a href={d.ppd.url} target="_blank" rel="nofollow noopener noreferrer">source</a></p>
    {d.facts.length > 0 && <><h3>Worth knowing in {d.name}</h3><ul>{d.facts.map((f) => <li>{f.text} <a href={f.url} target="_blank" rel="nofollow noopener noreferrer">source</a></li>)}</ul></>}
  </div>
</section>
