---
/** Embeddable page (iframe): the calculator alone. noindex, outside the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Child support calculator, every US state (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/child-support/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool kind="child-support" idPrefix="embed" methodHref={`${SITE_URL}/en/method/`} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/child-support/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · calculated in your browser · an estimate, not legal advice</p>
  </body>
</html>
